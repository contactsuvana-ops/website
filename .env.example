# Firestore Configuration

# Set to "development" for local testing with emulator
NODE_ENV=development

# Local Firestore Emulator (for development only)
# Leave this empty for production
FIRESTORE_EMULATOR_HOST=localhost:8080

# Production Firebase Credentials (choose one method)

# Method 1: Full JSON credentials (recommended for deployment platforms)
# Get this from Firebase Console > Project Settings > Service Accounts > Private Key
FIREBASE_CREDENTIALS=

# OR Method 2: Individual variables
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email Configuration (optional)
# Leave empty to skip email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# API Server
PORT=3000
BASE_PATH=/

# Database Selection (default: Firestore)
# Set to "false" or leave empty to use Firestore
USE_FIRESTORE=true
