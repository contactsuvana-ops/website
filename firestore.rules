rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Submissions collection - allow read/write from authenticated backend only
    match /submissions/{submissionId} {
      // Allow read/write only from backend via App Check
      allow read, write: if request.auth != null;
      
      // Alternatively, use this for public submissions (no auth required)
      // allow read: if true;
      // allow write: if request.auth != null;
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
